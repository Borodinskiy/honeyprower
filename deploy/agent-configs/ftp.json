{
  "center_url": "http://app:8080",
  "token": "demo-ftp-token",
  "trap": {
    "class": "dialog",
    "bind": "0.0.0.0",
    "port": 2121,
    "params": {
      "greeting": "220 (vsFTPd 3.0.5)\r\n",
      "decoder": "line",
      "default_response": "530 Please login with USER and PASS.\r\n",
      "rules": [
        { "match": "^USER\\s+(.*)$", "response": "331 Please specify the password.\r\n", "capture": "username" },
        { "match": "^PASS\\s?(.*)$", "response": "530 Login incorrect.\r\n", "capture": "password" },
        { "match": "^SYST", "response": "215 UNIX Type: L8\r\n" },
        { "match": "^QUIT", "response": "221 Goodbye.\r\n", "close": true }
      ]
    }
  }
}
